<!doctype html>
<html lang="ar" dir="rtl">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>FM | هدايا وورد • الشرقية</title>
  <meta name="description" content="FM | هدايا وورد • الشرقية — تنسيق هدايا وورد وتوصيل فوري بنفس اليوم.">
  <style>@import url('https://fonts.googleapis.com/css2?family=Cairo:wght@400;500;600;700&family=Playfair+Display:wght@500;600&display=swap');

:root{
  --cream:#fbf4ef;--paper:#fffaf7;--brown:#5d3f39;--muted:#8b716a;
  --rose:#a77773;--rose2:#c79b96;--line:#eadbd5;--dark:#30201d;
}
*{box-sizing:border-box} html{scroll-behavior:smooth}
body{margin:0;background:var(--cream);color:var(--brown);font-family:Cairo,Arial,sans-serif}
a{text-decoration:none;color:inherit}.topbar{height:76px;background:#fffaf8;display:flex;align-items:center;justify-content:space-between;padding:0 6%;border-bottom:1px solid var(--line);position:sticky;top:0;z-index:20}
.brand{display:flex;align-items:center;gap:10px}.brand-mark{font-family:"Playfair Display";font-size:36px;line-height:1}.brand-sub{font-size:13px;line-height:1.1}.brand-sub small{color:var(--muted)}
nav{display:flex;gap:34px;font-size:14px}nav a{padding:28px 0}nav a.active{font-weight:700;border-bottom:2px solid var(--brown)}
.icon-btn{font-size:21px}
.hero{min-height:540px;display:grid;grid-template-columns:1.05fr .95fr;background:linear-gradient(115deg,#6d4a42,#b38a7c);color:#fff;overflow:hidden}
.hero-copy{padding:78px 8% 65px 9%;display:flex;flex-direction:column;justify-content:center}
.eyebrow{font-size:16px;opacity:.9;margin-bottom:12px}.hero h1{font-family:"Playfair Display",serif;font-size:48px;line-height:1.2;margin:0 0 18px}.hero h1 span{font-family:Cairo;font-size:31px}.hero p{font-size:17px;max-width:560px;line-height:2;margin:0 0 24px}
.hero-actions{display:flex;gap:12px;flex-wrap:wrap}.btn{padding:12px 25px;border-radius:28px;border:1px solid rgba(255,255,255,.55);font-weight:700}.btn.primary{background:#fff;color:var(--brown)}.btn.ghost{background:transparent;color:#fff}
.highlights{display:flex;gap:28px;margin-top:32px}.highlights div{display:flex;align-items:center;gap:8px;font-size:13px}.highlights b{font-size:19px}
.hero-art{position:relative;display:flex;align-items:center;justify-content:center;background:radial-gradient(circle at 55% 48%,#b99585,#6d4a42 65%)}.flower-orb{font-size:180px;filter:drop-shadow(0 20px 25px #38241e88);transform:rotate(-8deg)}.floating-card{position:absolute;bottom:52px;left:14%;background:#fff;color:var(--brown);padding:13px 20px;border-radius:15px;box-shadow:0 12px 30px #3a211c44}.floating-card small{color:var(--muted)}
.section{padding:60px 7%}.section-title{text-align:center;margin-bottom:30px}.section-title h2{margin:0;font-size:29px}.section-title span{display:block;margin-top:7px}
.category-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:18px}.category-grid a{height:150px;background:#fff;border:1px solid var(--line);border-radius:20px;display:flex;align-items:center;justify-content:center;flex-direction:column;gap:8px;font-size:38px;box-shadow:0 7px 22px #6d4a4210;transition:.2s}.category-grid a:hover{transform:translateY(-4px)}.category-grid strong{font-size:16px}
.filter-row{display:flex;justify-content:center;gap:8px;flex-wrap:wrap;margin-bottom:25px}.filter{font:inherit;border:1px solid var(--line);background:#fff;padding:8px 18px;border-radius:22px;color:var(--brown);cursor:pointer}.filter.active{background:var(--brown);color:#fff}
.product-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:20px}.product{background:#fff;border:1px solid var(--line);border-radius:18px;overflow:hidden;box-shadow:0 7px 20px #6d4a4210}.product img{width:100%;height:230px;object-fit:cover;display:block}.product-body{padding:15px}.product h3{font-size:16px;margin:0 0 7px}.product .price{font-weight:700;font-size:18px;margin-bottom:12px}.order{display:block;background:var(--rose);color:#fff;text-align:center;padding:9px;border-radius:20px;font-size:13px}
.features{display:grid;grid-template-columns:repeat(4,1fr);background:#f4e5df;padding:28px 7%;border-top:1px solid var(--line);border-bottom:1px solid var(--line)}.features div{text-align:center;border-left:1px solid #d9c4bd;padding:8px}.features div:first-child{border:0}.features b{display:block;font-size:22px;margin-bottom:5px}.features strong,.features span{display:block}.features span{font-size:12px;color:var(--muted);margin-top:2px}
.contact-banner{margin:0;background:#34221e;color:#fff;padding:48px 8%;display:flex;align-items:center;justify-content:space-between}.contact-banner h2{margin:6px 0 16px;font-size:24px}.contact-banner small{opacity:.8}.whatsapp{display:inline-block;background:#fff;color:var(--brown);padding:10px 20px;border-radius:25px;font-weight:700}.contact-mark{text-align:center;font-family:"Playfair Display";font-size:46px}.contact-mark small{font-family:Cairo;font-size:11px}
footer{background:#211613;color:#d9c7c0;padding:18px 7%;display:flex;justify-content:space-between;font-size:12px}
@media(max-width:900px){nav{display:none}.hero{grid-template-columns:1fr}.hero-art{min-height:230px}.hero-copy{padding:55px 7%}.hero h1{font-size:39px}.hero h1 span{font-size:25px}.category-grid,.product-grid{grid-template-columns:repeat(2,1fr)}.features{grid-template-columns:repeat(2,1fr);gap:10px}.features div{border:0}.contact-banner{flex-direction:column;text-align:center;gap:25px}footer{flex-direction:column;gap:8px}}
@media(max-width:500px){.topbar{height:65px;padding:0 5%}.brand-mark{font-size:30px}.brand-sub{font-size:11px}.hero-art{display:none}.section{padding:45px 5%}.category-grid{gap:10px}.category-grid a{height:120px}.product-grid{grid-template-columns:1fr 1fr;gap:10px}.product img{height:170px}.product-body{padding:10px}.product h3{font-size:14px}.product .price{font-size:16px}.highlights{gap:12px;flex-wrap:wrap}.highlights div{font-size:11px}.contact-banner{padding:38px 5%}}
</style>
</head>
<body>
  <header class="topbar">
    <a class="brand" href="#home">
      <span class="brand-mark">FM</span>
      <span class="brand-sub">هدايا وورد<br><small>الشرقية</small></span>
    </a>
    <nav>
      <a class="active" href="#home">الرئيسية</a>
      <a href="#products">المنتجات</a>
      <a href="#categories">مناسبات</a>
      <a href="#contact">تواصل معنا</a>
    </nav>
    <a class="icon-btn" href="#products" aria-label="المنتجات">🛍️</a>
  </header>

  <main id="home">
    <section class="hero">
      <div class="hero-copy">
        <div class="eyebrow">FM | هدايا وورد • الشرقية</div>
        <h1>هدايا صغيرة..<br><span>تصنع لحظات كبيرة ♥</span></h1>
        <p>تنسيق هدايا وورد بعناية، مع توصيل فوري بنفس اليوم داخل الشرقية.</p>
        <div class="hero-actions">
          <a class="btn primary" href="#products">تسوق الآن ←</a>
          <a class="btn ghost" href="https://wa.me/966535057378?text=السلام%20عليكم%20FM%20أرغب%20بالطلب">اطلب عبر واتساب</a>
        </div>
        <div class="highlights">
          <div><b>🌷</b><span>تنسيق هدايا وورد</span></div>
          <div><b>⚡</b><span>توصيل فوري بنفس اليوم</span></div>
          <div><b>📍</b><span>الشرقية</span></div>
        </div>
      </div>
      <div class="hero-art">
        <div class="flower-orb">🌹</div>
        <div class="floating-card">هدية مرتبة بعناية<br><small>تستاهل كل لحظة ♥</small></div>
      </div>
    </section>

    <section class="section" id="categories">
      <div class="section-title">
        <h2>تصفحوا أقسامنا</h2>
        <span>♥</span>
      </div>
      <div class="category-grid">
        <a href="#products" data-filter="ورد">🌹<strong>الورد</strong></a>
        <a href="#products" data-filter="هدايا">🎁<strong>هدايا</strong></a>
        <a href="#products" data-filter="مناسبات">💝<strong>مناسبات</strong></a>
        <a href="#products" data-filter="عروض">✨<strong>عروض</strong></a>
      </div>
    </section>

    <section class="section" id="products">
      <div class="section-title">
        <h2>منتجاتنا</h2>
        <span>♥</span>
      </div>
      <div class="filter-row">
        <button class="filter active" data-filter="الكل">الكل</button>
        <button class="filter" data-filter="ورد">ورد</button>
        <button class="filter" data-filter="هدايا">هدايا</button>
        <button class="filter" data-filter="مناسبات">مناسبات</button>
        <button class="filter" data-filter="عروض">عروض</button>
      </div>
      <div id="productGrid" class="product-grid"></div>
    </section>

    <section class="features">
      <div><b>♡</b><strong>تغليف أنيق</strong><span>لكل مناسبة</span></div>
      <div><b>🛡</b><strong>جودة عالية</strong><span>بكل تفاصيلها</span></div>
      <div><b>🚚</b><strong>توصيل فوري</strong><span>بنفس اليوم</span></div>
      <div><b>♥</b><strong>خدمة عملاء</strong><span>نخدمك بكل حب</span></div>
    </section>

    <section class="contact-banner" id="contact">
      <div>
        <small>مستعدين دائماً لخدمتك ♥</small>
        <h2>للطلب والاستفسار عبر الواتساب</h2>
        <a class="whatsapp" href="https://wa.me/966535057378?text=السلام%20عليكم%20FM%20أرغب%20بالطلب">واتساب: +966 53 505 7378</a>
      </div>
      <div class="contact-mark">FM<br><small>هدايا وورد • الشرقية</small></div>
    </section>
  </main>

  <footer>
    <span>FM | هدايا وورد • الشرقية</span>
    <span>جميع الحقوق محفوظة © <span id="year"></span></span>
  </footer>

  <script>// أضف منتجاتك هنا بنفس الصيغة.
// category يمكن أن تكون: ورد أو هدايا أو مناسبات أو عروض
// image: ضع مسار الصورة داخل مجلد assets مثل "assets/product-2.jpg"

const PRODUCTS = [
  {
    id: 1,
    name: "تنسيق ورد",
    price: 140,
    category: "ورد",
    image: "data:image/jpeg;base64,",
    description: "تنسيق ورد أنيق مناسب للإهداء",
    message: "السلام عليكم FM، أرغب بطلب: تنسيق ورد - 140 ريال"
  }
];

// مثال لإضافة منتج جديد:
// {
//   id: 2,
//   name: "اسم المنتج",
//   price: 180,
//   category: "هدايا",
//   image: "assets/product-2.jpg",
//   description: "وصف مختصر",
//   message: "السلام عليكم FM، أرغب بطلب: اسم المنتج - 180 ريال"
// }

const WA = "966535057378";
const grid = document.getElementById("productGrid");
const buttons = document.querySelectorAll(".filter");

function money(n){ return `${Number(n).toLocaleString("ar-SA")} ريال`; }

function render(filter="الكل"){
  const list = filter==="الكل" ? PRODUCTS : PRODUCTS.filter(p=>p.category===filter);
  grid.innerHTML = list.map(p => `
    <article class="product">
      <img src="${p.image}" alt="${p.name}" loading="lazy">
      <div class="product-body">
        <h3>${p.name}</h3>
        <div class="price">${money(p.price)}</div>
        <a class="order" href="https://wa.me/${WA}?text=${encodeURIComponent(p.message || `السلام عليكم FM، أرغب بطلب: ${p.name} - ${p.price} ريال`)}" target="_blank" rel="noopener">اطلب الآن عبر واتساب</a>
      </div>
    </article>
  `).join("") || `<p style="grid-column:1/-1;text-align:center">لا توجد منتجات في هذا القسم حالياً.</p>`;
}

buttons.forEach(btn=>{
  btn.addEventListener("click", ()=>{
    buttons.forEach(b=>b.classList.remove("active"));
    btn.classList.add("active");
    render(btn.dataset.filter);
  });
});

document.querySelectorAll(".category-grid a").forEach(link=>{
  link.addEventListener("click", ()=>{
    const f=link.dataset.filter;
    setTimeout(()=>{
      buttons.forEach(b=>b.classList.toggle("active", b.dataset.filter===f));
      render(f);
    },0);
  });
});

document.getElementById("year").textContent = new Date().getFullYear();
render();
</script>
</body>
</html>
